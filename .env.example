CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Customer authentication and private artwork storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=artwork-files

# Server-only. Never expose this value through NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Optional dedicated secret for durable private artwork links in order emails.
# If omitted, the server falls back to SUPABASE_SERVICE_ROLE_KEY.
ARTWORK_LINK_SECRET=

# Public Hue Studio origin used in emailed artwork links (no trailing slash).
NEXT_PUBLIC_SITE_URL=

# Protects /admin and its server APIs. Use a long unique password.
ADMIN_DASHBOARD_SECRET=

# Recommended: a separate random secret used only to sign four-hour admin sessions.
# Keep this server-only and different from the password above.
ADMIN_SESSION_SECRET=

# Order notifications
RESEND_API_KEY=
QUOTE_TO_EMAIL=jason@huegraphics.cc
QUOTE_FROM_EMAIL=Hue Graphics Orders <orders@huegraphics.cc>

# Emergency operations switch. Set to false in Vercel and redeploy to pause new orders.
CHECKOUT_ENABLED=true

# Optional Canva import integration. Configure all three or leave all three blank.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=
CANVA_SCOPES=
