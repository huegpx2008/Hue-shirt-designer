CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Customer authentication and private artwork storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=artwork-files

# Server-only. Never expose this value through NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Optional dedicated secret for durable private artwork links in order emails.
# If omitted, the server falls back to SUPABASE_SERVICE_ROLE_KEY.
ARTWORK_LINK_SECRET=

# Public Hue Studio origin used for canonical links, sitemap entries and emailed
# artwork links (no trailing slash). Update this when the final domain is ready.
NEXT_PUBLIC_SITE_URL=https://studio.huegraphics.cc

# Keep false on temporary/test deployments. Set true only on the final production
# domain when it is ready to appear in search engines.
ALLOW_INDEXING=false

# Optional Google Search Console HTML verification token. Enter only the token,
# not the surrounding meta tag.
GOOGLE_SITE_VERIFICATION=

# Protects /admin and its server APIs. Use a long unique password.
ADMIN_DASHBOARD_SECRET=

# Recommended: a separate random secret used only to sign four-hour admin sessions.
# Keep this server-only and different from the password above.
ADMIN_SESSION_SECRET=

# Authorizes the scheduled Vercel artwork-maintenance job.
CRON_SECRET=

# Order notifications
RESEND_API_KEY=
QUOTE_TO_EMAIL=jason@huegraphics.cc
QUOTE_FROM_EMAIL=Hue Graphics Orders <orders@huegraphics.cc>
HUE_WEBSITE_URL=https://www.huegraphics.cc
HUE_CONTACT_URL=https://www.huegraphics.cc/contact
HUE_CONTACT_EMAIL=jason@huegraphics.cc
HUE_CONTACT_PHONE=(770) 867-3520 / Office Mobile: (678) 238-8913
HUE_ADDRESS=741 Harry McCarty Road, Suite 101, Bethlehem, GA 30620

# Emergency operations switch. Set to false in Vercel and redeploy to pause new orders.
CHECKOUT_ENABLED=true

# PayPal Checkout. Start in sandbox and keep disabled until the SQL migration,
# Vercel variables, webhook, and sandbox buyer test have all been verified.
PAYPAL_CHECKOUT_ENABLED=false
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MERCHANT_ID=

# Server-only random secret used to bind a captured PayPal payment to one Hue order.
PAYPAL_ORDER_SIGNING_SECRET=

# Optional Canva import integration. Configure all three or leave all three blank.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=
CANVA_SCOPES=

# Optional secondary production archive. Supabase remains authoritative and
# checkout continues if Google Drive is unavailable.
# These conservative defaults keep paid Supabase storage live for much longer
# before Drive backup and eventual cleanup. Adjust without changing application code.
HUE_ORDER_DRIVE_ARCHIVE_DELAY_DAYS=90
HUE_LIBRARY_DRIVE_ARCHIVE_DELAY_DAYS=365
HUE_SUPABASE_ORIGINAL_RETENTION_DAYS=365
HUE_GUEST_UPLOAD_RETENTION_DAYS=7
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
